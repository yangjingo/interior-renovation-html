{
  "version": 1,
  "scope": "private user-controlled example",
  "entry_inheritance": "Every manifest asset and direct visual inherits defaults; an entry must override each value that differs.",
  "defaults": {
    "origin": "generated during the current design conversation",
    "contains_source_photo": false,
    "contains_face": false,
    "contains_watermark": false,
    "contains_private_plan": false,
    "reuse_scope": "bundled sanitised example and the user's private project use",
